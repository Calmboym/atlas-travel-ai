# .env.example
#
# DOCUMENTED: this file's existence is confirmed — DEBUG_LOG.md M0
# record: ".gitignore, .env.example, README.md" delivered.
#
# DOCUMENTED verbatim variable name: OPENAI_API_KEY — DEBUG_LOG.md
# Known Issues: "AI smoke tests require OPENAI_API_KEY ... Tests
# auto-skip when key is absent".
#
# RECONSTRUCTED variable names below (Postgres/Redis/Qdrant/env-mode):
# the underlying services are documented (ARCHITECTURE.md §9-10), but
# exact environment-variable names are not given verbatim anywhere.

# --- Database (PostgreSQL) ---
# RECONSTRUCTED name/format.
DATABASE_URL=postgresql+asyncpg://atlas:changeme@localhost:5432/atlas

# --- Cache / rate limiting (Redis) ---
# RECONSTRUCTED name/format.
REDIS_URL=redis://localhost:6379

# --- Vector database (Qdrant) ---
# RECONSTRUCTED name/format.
QDRANT_URL=http://localhost:6333

# --- AI provider ---
# DOCUMENTED verbatim (DEBUG_LOG.md Known Issues).
OPENAI_API_KEY=

# --- Auth (ATLAS-P1-AUTH-05) ---
# ADDED. Signs JWT access tokens issued by POST /api/v1/auth/login.
# GENERATE A REAL RANDOM VALUE for any non-development environment —
# app/core/config.py logs a warning and refuses to treat this as safe
# if APP_ENV isn't "development" and this is left unset. Never commit
# a real value; this file only ever holds an empty placeholder.
SECRET_KEY=

# --- CORS (ATLAS-P1-AUTH-05) ---
# ADDED. Comma-separated list of origins allowed to make
# credentialed (cookie-bearing) requests to this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Environment ---
# RECONSTRUCTED name. GUIDELINES.md §17 confirms Development / Testing
# / Production environments exist and that secrets must never be
# shared between them, but does not give a variable name for the
# environment flag itself.
APP_ENV=development

# --- Frontend → backend URL ---
# RECONSTRUCTED name. Needed for the documented frontend smoke health
# page to call the documented backend /api/v1/health endpoint
# (DEBUG_LOG.md), but the variable name itself is not given verbatim.
NEXT_PUBLIC_API_URL=http://localhost:8000
